{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://urouter.local/schema/catalog-v1.json",
  "title": "uRouter static model catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "providers", "models"],
  "properties": {
    "schema_version": { "const": 1 },
    "providers": {
      "type": "array",
      "items": { "$ref": "#/$defs/provider" }
    },
    "models": {
      "type": "array",
      "items": { "$ref": "#/$defs/model" }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "checked_at", "confidence"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "checked_at": { "type": "string", "minLength": 1 },
        "confidence": { "enum": ["official", "verified", "community", "override"] }
      }
    },
    "auth": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "env"],
          "properties": {
            "kind": { "const": "api_key_env" },
            "env": { "type": "string", "minLength": 1 },
            "header": { "type": "string" },
            "prefix": { "type": "string" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "path"],
          "properties": {
            "kind": { "const": "oauth_bearer_file" },
            "path": { "type": "string", "minLength": 1 },
            "header": { "type": "string" },
            "prefix": { "type": "string" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "env"],
          "properties": {
            "kind": { "const": "ambient_env" },
            "env": { "type": "string", "minLength": 1 },
            "header": { "type": "string" },
            "prefix": { "type": "string" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "token_url",
            "client_id_env",
            "client_secret_env",
            "token_file"
          ],
          "properties": {
            "kind": { "const": "oauth_client_credentials" },
            "token_url": { "type": "string", "minLength": 1 },
            "client_id_env": { "type": "string", "minLength": 1 },
            "client_secret_env": { "type": "string", "minLength": 1 },
            "token_file": { "type": "string", "minLength": 1 },
            "scope": { "type": ["string", "null"] },
            "audience": { "type": ["string", "null"] },
            "header": { "type": "string" },
            "prefix": { "type": "string" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind"],
          "properties": {
            "kind": { "const": "none" },
            "allow_remote": { "type": "boolean" }
          },
          "additionalProperties": false
        }
      ]
    },
    "wire_api": {
      "oneOf": [
        { "enum": ["open_ai_chat", "open_ai_responses", "anthropic_messages"] },
        {
          "type": "object",
          "required": ["custom"],
          "properties": { "custom": { "type": "string", "minLength": 1 } },
          "additionalProperties": false
        }
      ]
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "base_url", "auth", "source"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "base_url": { "type": "string", "minLength": 1 },
        "built_in": { "type": "boolean" },
        "auth": { "$ref": "#/$defs/auth" },
        "env": { "type": "object", "additionalProperties": { "type": "string" } },
        "headers": { "type": "object", "additionalProperties": { "type": "string" } },
        "source": { "$ref": "#/$defs/source" }
      }
    },
    "rate": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]{1,9})?$" },
    "rates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "output", "cache_read", "cache_write"],
      "properties": {
        "input": { "$ref": "#/$defs/rate" },
        "output": { "$ref": "#/$defs/rate" },
        "cache_read": { "$ref": "#/$defs/rate" },
        "cache_write": { "$ref": "#/$defs/rate" }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "upstream_id", "name", "provider", "api", "cost",
        "capabilities", "compat", "lifecycle", "source"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "upstream_id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "provider": { "type": "string", "minLength": 1 },
        "api": { "$ref": "#/$defs/wire_api" },
        "base_url": { "type": ["string", "null"] },
        "cost": {
          "type": "object",
          "required": ["base", "tiers"],
          "properties": {
            "base": { "$ref": "#/$defs/rates" },
            "tiers": { "type": "array" },
            "long_cache_write": { "type": ["object", "null"] }
          }
        },
        "capabilities": { "type": "object" },
        "compat": { "type": "object" },
        "headers": { "type": "object", "additionalProperties": { "type": "string" } },
        "aliases": { "type": "array", "items": { "type": "string" } },
        "lifecycle": { "enum": ["active", "deprecated", "retired"] },
        "source": { "$ref": "#/$defs/source" }
      }
    }
  }
}
