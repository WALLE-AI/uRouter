{
  "openapi": "3.1.0",
  "info": {
    "title": "uRouter Gateway API",
    "version": "0.1.0",
    "description": "P0 compatibility baseline. Schemas are versioned independently from the binary."
  },
  "servers": [{ "url": "http://127.0.0.1:8787" }],
  "paths": {
    "/health": { "get": { "operationId": "health", "responses": { "200": { "description": "Process is live" } } } },
    "/health/live": { "get": { "operationId": "healthLive", "responses": { "200": { "description": "Process is live" } } } },
    "/health/ready": { "get": { "operationId": "healthReady", "responses": { "200": { "description": "Gateway is ready" }, "503": { "description": "Gateway is draining or shared state is unavailable" } } } },
    "/openapi.json": { "get": { "operationId": "openapi", "responses": { "200": { "description": "This contract", "content": { "application/json": { "schema": { "type": "object" } } } } } } },
    "/v1/models": { "get": { "operationId": "models", "responses": { "200": { "description": "OpenAI-compatible model list", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ModelList" } } } } } } },
    "/v1/catalog": { "get": { "operationId": "catalogStatus", "security": [{ "managementBearer": [] }], "responses": { "200": { "description": "Active atomic Catalog and Route revision", "headers": { "ETag": { "description": "Quoted active control revision", "schema": { "type": "string" } } } } } } },
    "/v1/catalog/refresh": { "post": { "operationId": "refreshCatalog", "security": [{ "managementBearer": [] }], "responses": { "200": { "description": "Validated candidate was atomically activated" }, "409": { "$ref": "#/components/responses/Error" } } } },
    "/v1/catalog/rollback": { "post": { "operationId": "rollbackCatalog", "security": [{ "managementBearer": [] }], "responses": { "200": { "description": "Previous revision was atomically restored" }, "409": { "$ref": "#/components/responses/Error" } } } },
    "/v1/explain": { "post": { "operationId": "explain", "requestBody": { "$ref": "#/components/requestBodies/ChatRequest" }, "responses": { "200": { "description": "Dry-run routing decision", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ExplainResponse" } } } }, "400": { "$ref": "#/components/responses/Error" } } } },
    "/v1/chat/completions": { "post": { "operationId": "chatCompletions", "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }], "requestBody": { "$ref": "#/components/requestBodies/ChatRequest" }, "responses": { "200": { "description": "OpenAI-compatible completion or stream", "headers": { "x-urouter-request-id": { "$ref": "#/components/headers/RequestId" }, "x-urouter-decision-id": { "$ref": "#/components/headers/DecisionId" } } }, "400": { "$ref": "#/components/responses/Error" }, "409": { "$ref": "#/components/responses/Error" }, "503": { "$ref": "#/components/responses/Error" } } } },
    "/v1/responses": { "post": { "operationId": "openAiResponses", "description": "OpenAI Responses-compatible entry using the shared normalized IR and routing core, including incremental SSE streaming.", "responses": { "200": { "description": "Responses-compatible result or event stream" }, "400": { "$ref": "#/components/responses/Error" } } } },
    "/v1/messages": { "post": { "operationId": "anthropicMessages", "description": "Anthropic Messages-compatible entry using the shared normalized IR and routing core, including incremental SSE streaming.", "responses": { "200": { "description": "Anthropic-compatible result or event stream" }, "400": { "$ref": "#/components/responses/Error" } } } },
    "/v1/artifacts": { "get": { "operationId": "artifactStatus", "security": [{ "managementBearer": [] }], "responses": { "200": { "description": "Active/candidate artifact status, bound revisions, staleness, and audit log" }, "404": { "$ref": "#/components/responses/Error" } } } },
    "/v1/artifacts/promote": { "post": { "operationId": "promoteArtifact", "security": [{ "managementBearer": [] }], "responses": { "200": { "description": "Candidate promoted to active" }, "409": { "$ref": "#/components/responses/Error" } } } },
    "/v1/artifacts/rollback": { "post": { "operationId": "rollbackArtifact", "security": [{ "managementBearer": [] }], "responses": { "200": { "description": "Last-good artifact restored" }, "409": { "$ref": "#/components/responses/Error" } } } },
    "/v1/artifacts/kill": { "post": { "operationId": "killArtifact", "security": [{ "managementBearer": [] }], "responses": { "200": { "description": "Artifact kill switch changed" }, "404": { "$ref": "#/components/responses/Error" } } } },
    "/v1/artifacts/rollout": { "post": { "operationId": "updateArtifactRollout", "security": [{ "managementBearer": [] }], "responses": { "200": { "description": "Shadow/canary rollout stage updated" }, "400": { "$ref": "#/components/responses/Error" } } } },
    "/v1/artifacts/observe": { "post": { "operationId": "observeArtifact", "security": [{ "managementBearer": [] }], "responses": { "200": { "description": "Canary observation accepted and hard-threshold rollback evaluated" }, "400": { "$ref": "#/components/responses/Error" } } } },
    "/v1/adapters/{harness}/chat/completions": { "post": { "operationId": "adapterChatCompletions", "parameters": [{ "name": "harness", "in": "path", "required": true, "schema": { "type": "string", "enum": ["aionui", "workbuddy"] } }], "requestBody": { "$ref": "#/components/requestBodies/ChatRequest" }, "responses": { "200": { "description": "Adapter completion" }, "400": { "$ref": "#/components/responses/Error" } } } },
    "/v1/decisions": { "get": { "operationId": "decisions", "security": [{ "managementBearer": [] }], "responses": { "200": { "description": "Paginated decision records" }, "401": { "$ref": "#/components/responses/Error" }, "403": { "$ref": "#/components/responses/Error" } } } },
    "/v1/stats": { "get": { "operationId": "stats", "security": [{ "managementBearer": [] }], "responses": { "200": { "description": "Tenant-scoped usage, separately attributed downgrade/cache savings, and observed quality" }, "401": { "$ref": "#/components/responses/Error" }, "403": { "$ref": "#/components/responses/Error" } } } },
    "/v1/decisions/{id}": { "parameters": [{ "$ref": "#/components/parameters/Id" }], "get": { "operationId": "decisionById", "security": [{ "managementBearer": [] }], "responses": { "200": { "description": "Decision record" }, "404": { "$ref": "#/components/responses/Error" } } }, "delete": { "operationId": "deleteDecision", "security": [{ "managementBearer": [] }], "responses": { "204": { "description": "Deleted" }, "404": { "$ref": "#/components/responses/Error" } } } },
    "/v1/tasks/{id}/records": { "delete": { "operationId": "deleteTaskRecords", "parameters": [{ "$ref": "#/components/parameters/Id" }], "security": [{ "managementBearer": [] }], "responses": { "200": { "description": "Deletion result" } } } },
    "/v1/tenant/records": { "delete": { "operationId": "deleteTenantRecords", "security": [{ "managementBearer": [] }], "responses": { "200": { "description": "Deletion result" } } } },
    "/v1/feedback": { "post": { "operationId": "feedback", "responses": { "200": { "description": "Idempotent feedback result" }, "400": { "$ref": "#/components/responses/Error" } } } },
    "/v1/feedback/{turn}": { "get": { "operationId": "feedbackByTurn", "parameters": [{ "name": "turn", "in": "path", "required": true, "schema": { "type": "string" } }], "security": [{ "managementBearer": [] }], "responses": { "200": { "description": "Feedback signals" } } } },
    "/metrics": { "get": { "operationId": "metrics", "responses": { "200": { "description": "Prometheus text exposition", "content": { "text/plain": { "schema": { "type": "string" } } } } } } },
    "/v1/tiers": { "get": { "operationId": "tiers", "security": [{ "managementBearer": [] }], "responses": { "200": { "description": "Tier and deployment health" } } } },
    "/v1/tasks/{id}/binding": { "parameters": [{ "$ref": "#/components/parameters/Id" }], "get": { "operationId": "taskBinding", "security": [{ "managementBearer": [] }], "responses": { "200": { "description": "Task binding" }, "404": { "$ref": "#/components/responses/Error" } } }, "delete": { "operationId": "deleteTaskBinding", "security": [{ "managementBearer": [] }], "responses": { "204": { "description": "Deleted" } } } },
    "/v1/sessions/{conversation}/{branch}/binding": { "parameters": [{ "name": "conversation", "in": "path", "required": true, "schema": { "type": "string" } }, { "name": "branch", "in": "path", "required": true, "schema": { "type": "string" } }], "get": { "operationId": "sessionBinding", "security": [{ "managementBearer": [] }], "responses": { "200": { "description": "Session binding" }, "404": { "$ref": "#/components/responses/Error" } } }, "delete": { "operationId": "deleteSessionBinding", "security": [{ "managementBearer": [] }], "responses": { "204": { "description": "Deleted" } } } }
  },
  "components": {
    "securitySchemes": { "managementBearer": { "type": "http", "scheme": "bearer" } },
    "headers": { "RequestId": { "description": "Opaque logical Gateway request identifier", "schema": { "type": "string" } }, "DecisionId": { "description": "Opaque immutable routing decision identifier when a decision exists", "schema": { "type": "string" } } },
    "parameters": { "Id": { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }, "IdempotencyKey": { "name": "Idempotency-Key", "in": "header", "required": false, "description": "Tenant-scoped logical operation key. Reuse with a different canonical request returns 409; response replay is not currently provided.", "schema": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[!-~]+$" } } },
    "requestBodies": { "ChatRequest": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ChatRequest" } } } } },
    "responses": { "Error": { "description": "uRouter error", "headers": { "x-urouter-request-id": { "$ref": "#/components/headers/RequestId" }, "x-urouter-decision-id": { "$ref": "#/components/headers/DecisionId" } }, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } } } },
    "schemas": {
      "ChatRequest": { "type": "object", "required": ["model", "messages"], "properties": { "model": { "type": "string" }, "messages": { "type": "array", "items": { "type": "object" } }, "stream": { "type": "boolean" }, "tools": { "type": "array", "items": { "type": "object" } }, "urouter": { "type": "object" } }, "additionalProperties": true },
      "ModelList": { "type": "object", "required": ["object", "data"], "properties": { "object": { "const": "list" }, "data": { "type": "array", "items": { "type": "object", "required": ["id", "object", "owned_by"] } } } },
      "ExplainResponse": { "type": "object", "required": ["schema_version", "feature_frame", "routing_trace", "route_id", "tier", "model", "reason", "requirement", "admission", "data_policy"], "properties": { "schema_version": { "const": 1 }, "feature_frame": { "type": "object", "required": ["schema_version", "message_count", "input_text_bytes", "available_tool_count", "content", "requests"] }, "routing_trace": { "type": "object", "required": ["schema_version", "completeness", "policy", "decisions", "candidates"], "properties": { "decisions": { "type": "array", "items": { "type": "object", "required": ["rule", "outcome", "reason"] } } } }, "route_id": { "type": "string" }, "tier": { "type": "string" }, "model": { "type": "string" }, "reason": { "type": "string" }, "requirement": { "type": "object" }, "admission": { "type": "object" }, "data_policy": { "type": "object" } } },
      "ErrorEnvelope": { "type": "object", "required": ["error"], "properties": { "error": { "type": "object", "required": ["code", "message", "type"], "properties": { "code": { "type": "string" }, "message": { "type": "string" }, "type": { "const": "urouter_error" } } } } }
    }
  }
}
